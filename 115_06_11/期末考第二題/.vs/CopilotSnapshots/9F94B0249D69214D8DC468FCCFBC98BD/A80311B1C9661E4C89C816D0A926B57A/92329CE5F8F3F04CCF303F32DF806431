using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows.Forms;

namespace 期末考第二題
{
    public partial class AddForm : Form
    {
        private List<Employee> employees;

        public AddForm(List<Employee> employees)
        {
            this.employees = employees ?? new List<Employee>();
            InitializeComponent();

            // 綁定 designer 中的按鈕事件
            this.btnAdd.Click += BtnAdd_Click;
            this.btnClose.Click += (s, e) => this.Close();

            // 預設說明
            if (this.richTextBox1 != null)
            {
                this.richTextBox1.Text = "請輸入員工資料，按「新增」加入。";
            }
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            string idText = (txtId?.Text ?? string.Empty).Trim();
            string name = (txtName?.Text ?? string.Empty).Trim();

            if (string.IsNullOrWhiteSpace(idText) || string.IsNullOrWhiteSpace(name))
            {
                MessageBox.Show("請輸入員工編號與姓名。", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!int.TryParse(idText, out int id))
            {
                MessageBox.Show("員工編號必須為整數。", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (employees.Any(x => x.IdNumber == id))
            {
                MessageBox.Show("此員工編號已存在。", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            employees.Add(new Employee(
                txtName.Text.Trim(),
                id,
                txtDepartment.Text.Trim(),
                txtPosition.Text.Trim()
            ));

            MessageBox.Show("新增成功");
            Close();
        }
    }
}