using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Windows.Forms;

namespace 期末考第二題
{
    public class SearchForm : Form
    {
        private List<Employee> employees;
        private TextBox txtQuery;
        private RichTextBox resultBox;

        public SearchForm(List<Employee> employees)
        {
            this.employees = employees ?? new List<Employee>();
            BuildUI();
        }

        private void BuildUI()
        {
            Text = "查詢員工";
            Size = new Size(600, 480);
            StartPosition = FormStartPosition.CenterParent;

            Label title = new Label();
            title.Text = "查詢員工";
            title.Font = new Font("新細明體", 24, FontStyle.Bold);
            title.Location = new Point(40, 20);
            title.Size = new Size(300, 50);
            Controls.Add(title);

            Label lbl = new Label();
            lbl.Text = "輸入員工編號或姓名（部份姓名亦可）：";
            lbl.Location = new Point(40, 90);
            lbl.Size = new Size(400, 25);
            Controls.Add(lbl);

            txtQuery = new TextBox();
            txtQuery.Location = new Point(40, 120);
            txtQuery.Size = new Size(420, 30);
            Controls.Add(txtQuery);

            Button btnSearch = new Button();
            btnSearch.Text = "查詢";
            btnSearch.Location = new Point(480, 120);
            btnSearch.Size = new Size(80, 30);
            btnSearch.Click += BtnSearch_Click;
            Controls.Add(btnSearch);

            resultBox = new RichTextBox();
            resultBox.Location = new Point(40, 170);
            resultBox.Size = new Size(520, 240);
            resultBox.ReadOnly = true;
            Controls.Add(resultBox);

            Button btnClose = new Button();
            btnClose.Text = "關閉";
            btnClose.Location = new Point(240, 420);
            btnClose.Size = new Size(100, 30);
            btnClose.Click += (s, e) => Close();
            Controls.Add(btnClose);

            // 預設提示
            resultBox.Text = "請輸入查詢條件，按『查詢』。";
        }

        private void BtnSearch_Click(object sender, EventArgs e)
        {
            string q = (txtQuery.Text ?? string.Empty).Trim();
            resultBox.Clear();

            if (string.IsNullOrEmpty(q))
            {
                resultBox.Text = "請輸入員工編號或姓名。";
                return;
            }

            int id;
            IEnumerable<Employee> results;

            if (int.TryParse(q, out id))
            {
                results = employees.Where(x => x.IdNumber == id);
            }
            else
            {
                string lower = q.ToLower();
                results = employees.Where(x => (x.Name ?? string.Empty).ToLower().Contains(lower));
            }

            if (!results.Any())
            {
                resultBox.Text = "找不到符合條件的員工。";
                return;
            }

            foreach (var emp in results)
            {
                resultBox.AppendText(string.Format("{0} | {1} | {2} | {3}\n", emp.IdNumber, emp.Name, emp.Department, emp.Position));
            }
        }
    }
}
